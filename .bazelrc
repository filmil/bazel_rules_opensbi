common --registry=https://bcr.bazel.build
common --registry=https://raw.githubusercontent.com/filmil/bazel-registry/main

# Use the prebuilt protoc toolchain (pulled in by stardoc via protobuf) instead
# of compiling protoc from source.
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
build --incompatible_enable_proto_toolchain_resolution

# Keep build output readable for the firmware actions.
build --verbose_failures

# Allows temporary user settings to be placed here. From
# https://bazel.build/configure/best-practices#bazelrc-file
try-import %workspace%/user.bazelrc
